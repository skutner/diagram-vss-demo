@c2 command action=create shape=circle size=tiny color=black name=Spot2 at=505,385

## turn 16
# input: bundle Cow, CowHead, Spot1 and Spot2 into a group called Bessie
@c1 command action=group target=Cow,CowHead,Spot1,Spot2 name=Bessie

## turn 17

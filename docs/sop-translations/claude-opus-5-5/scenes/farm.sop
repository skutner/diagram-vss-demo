## turn 1
# input: Clear the canvas
@m1 mention quantifier=all
@c1 command action=delete target=$m1

## turn 2
# input: Let's draw a farm. Start with a pale cyan rectangle as the sky background, 780 wide and 250 tall, centred at 400,135, and call it Sky.
@c1 command action=create shape=rectangle color=cyan fill=light layer=background width=780 height=250 at=400,135 name=Sky

## turn 3
# input: Now the grass: a light green rectangle zone named Grass, 780 by 230, at 400,375.
@c1 command action=create shape=rectangle color=green fill=light layer=zone width=780 height=230 at=400,375 name=Grass

## turn 4
# input: Put a large gold circle in the top right for the sun and name it Sun.
@c1 command action=create shape=circle size=large color=gold position=topRight name=Sun

## turn 5
# input: huge red square at 170,330, call it Walls
@c1 command action=create shape=square size=huge color=red at=170,330 name=Walls

## turn 6
# input: Next a huge brown triangle named Roof at 170,204, that's the barn roof.
@c1 command action=create shape=triangle size=huge color=brown name=Roof at=170,204

## turn 7
# input: small navy rectangle for the door at 170,362, named Door
@c1 command action=create shape=rectangle size=small color=navy at=170,362 name=Door

## turn 8
# input: Write "BARN" on the roof please
@c1 command action=label target=Roof label="BARN"

## turn 9
# input: group Walls, Roof and Door as Barn
@c1 command action=group target=Walls,Roof,Door name=Barn

## turn 10
# input: Next to the barn I want a silo: a gray rectangle 50 wide and 150 tall, called Silo, right of Barn.

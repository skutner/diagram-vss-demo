@c1 command action=create shape=circle size=tiny color=red name=ClawL at=170,430
@c2 command action=create shape=circle size=tiny color=red name=ClawR at=270,430

## turn 18
# input: group CrabBody, ClawL and ClawR, call it Crab
@c1 command action=group target=CrabBody,ClawL,ClawR name=Crab

## turn 19
# input: Is CrabBody below Jelly?

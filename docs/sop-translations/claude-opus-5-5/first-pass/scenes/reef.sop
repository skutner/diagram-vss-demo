## turn 14
# input: What's in Finn2?
@q1 question ask=members target=Finn2

## turn 15
# input: Bubbles! four tiny white circles in a column at 380,110
@c1 command action=create count=4 shape=circle size=tiny color=white layout=column at=380,110

## turn 16
# input: crab on the sand: small red ellipse at 220,440 named CrabBody
@c1 command action=create shape=ellipse size=small color=red at=220,440 name=CrabBody

## turn 17

@c1 command action=group target=House2,Roof2 name=Home2
@c2 command action=group target=House3,Roof3 name=Home3

## turn 13
# input: Snowman! Bottom ball: a large white circle at 640,410, named Base
@c1 command action=create shape=circle size=large color=white at=640,410 name=Base


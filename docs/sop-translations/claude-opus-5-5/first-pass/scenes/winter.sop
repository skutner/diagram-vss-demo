## turn 16
# input: tiny orange triangle for the nose at 662,288, Carrot
@c1 command action=create shape=triangle size=tiny color=orange at=662,288 name=Carrot

## turn 17
# input: group Base, Belly, Noggin and Carrot as Snowman
@c1 command action=group target=Base,Belly,Noggin,Carrot name=Snowman

## turn 18

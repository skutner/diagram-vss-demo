# input: connect hexagon1, hexagon2, hexagon3, hexagon4 and hexagon5 one after the other
@c1 command action=connect from=hexagon1,hexagon2,hexagon3,hexagon4,hexagon5 pairing=chain

## turn 8
# input: and close the loop with an arrow from hexagon5 back to hexagon1
@c1 command action=connect from=hexagon5 to=hexagon1

## turn 9
# input: make every arrow teal and dashed
@c1 command action=set kind=edge quantifier=all color=teal style=dashed

## turn 10
# input: the loop arrow should be solid though
#! resolved: "the loop arrow" -> the arrow hexagon5 → hexagon1 of turn 8
@c1 command action=set from=hexagon5 to=hexagon1 style=solid


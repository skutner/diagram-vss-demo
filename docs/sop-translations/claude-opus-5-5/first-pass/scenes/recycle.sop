## turn 1
# input: Clear the canvas
@m1 mention quantifier=all
@c1 command action=delete target=$m1

## turn 2
# input: Infographic: how plastic recycling works. Background: faint green rectangle 780 x 480 in the center, background layer, named Bg.
@c1 command action=create shape=rectangle color=green fill=faint layer=background width=780 height=480 position=center name=Bg

## turn 3
# input: five medium green hexagons arranged in a circle in the middle
@c1 command action=create count=5 shape=hexagon size=medium color=green layout=circle position=center

## turn 4
# input: label the steps: hexagon1 "Collect"
#! note: hexagon1 … hexagon5 are written as the message writes them: the names the engine gives the five hexagons of turn 3 on a first play (no mention can pick the 2nd, 3rd or 4th of them); its counters survive a clear, so on a replay these names do not exist
@c1 command action=label target=hexagon1 label="Collect"

## turn 5
# input: hexagon2 "Sort", hexagon3 "Wash"
@c1 command action=label target=hexagon2 label="Sort"
@c2 command action=label target=hexagon3 label="Wash"

## turn 6
# input: hexagon4 gets "Melt" and hexagon5 "Make"
@c1 command action=label target=hexagon4 label="Melt"
@c2 command action=label target=hexagon5 label="Make"


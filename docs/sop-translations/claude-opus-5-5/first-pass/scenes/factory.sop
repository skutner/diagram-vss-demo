@c2 command action=create shape=circle color=gray name=RollerR position=rightOf anchor=Belt distance=16

## turn 5
# input: group Belt, RollerL and RollerR as Conveyor
@c1 command action=group target=Belt,RollerL,RollerR name=Conveyor

## turn 6

{"id": "nlb-11-035", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "setup": "@c1 command action=create shape=rectangle name=CheckIn label=\"Check in\" color=blue at=100,240\n@c2 command action=create shape=rectangle name=Warmup label=\"Warmup\" color=yellow at=300,240\n@c3 command action=create shape=rectangle name=Stage label=\"Stage\" color=green at=500,240\n@c4 command action=create shape=rectangle name=Exit label=\"Exit\" color=gray at=700,240\n@c5 command action=connect from=CheckIn,Warmup,Stage,Exit pairing=chain", "text": "Waiting room between check in and warmup."}
{"id": "nlb-11-036", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Route them through it."}
{"id": "nlb-11-037", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Call it Green room."}
{"id": "nlb-11-038", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Not green though. Same blue as check in."}
{"id": "nlb-11-039", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Warmup below that."}
{"id": "nlb-11-040", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Stage directly right of warmup."}
{"id": "nlb-11-041", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Can you see a route that skips warmup?"}
{"id": "nlb-11-042", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Add a tuning station above warmup."}
{"id": "nlb-11-043", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Optional detour. Warmup to tuning, tuning to stage."}
{"id": "nlb-11-044", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Mark that detour strings only."}
{"id": "nlb-11-045", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Both detour arrows dashed."}
{"id": "nlb-11-046", "domain": "student recital backstage flow", "kind": "self_correction", "session": "nlb-11-recital", "text": "Exit becomes Collect cases. No, Collect instruments."}
{"id": "nlb-11-047", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Then a new Exit after it."}
{"id": "nlb-11-048", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Parent pickup below the new exit."}
{"id": "nlb-11-049", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Arrow down to pickup."}
{"id": "nlb-11-050", "domain": "student recital backstage flow", "kind": "session", "session": "nlb-11-recital", "text": "Whole thing a bit bigger. Volunteers need to read it from the door."}

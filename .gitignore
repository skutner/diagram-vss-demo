# build folders of the VSS worlds (sop train writes model/, runs/, requests/, versions/ inside the world folder; the demo loads
# only the exported copy under docs/model/)
training/sketch/worlds/sketch/model/
training/sketch/worlds/sketch/runs/
training/sketch/worlds/sketch/requests/
training/sketch/worlds/sketch/versions/
training/sketch/worlds/real/
training/sketch/worlds_centres/
# micro-world build folders (train_micro.sh); the groupings GROUPS_*.json in it that are part of the workflow are added with git add -f
training/sketch/worlds_micro/
# scorer caches (short_bench outputs: training/sketch/short_bench/.gitignore)
layer_cache*.json
# Python / node
__pycache__/
*.pyc
node_modules/
# checkpoints of the research runs
research/attention/**/*.pt
# agent worktrees
.claude/worktrees/

# Local symlink to cached dependencies; never a repository artifact.
/training/laptop/node_modules
